{
  "name": "astrovivu-field-shift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Astrovivu - Field Shift: a mission-control decision-support tool that turns NASA Earth observations into crop-rotation guidance for farmers. NASA Space Apps Challenge 2026.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/ci/smoke.ts",
    "server": "tsx server/index.ts",
    "data:samples": "tsx scripts/cache-samples.ts",
    "data:rasters": "tsx scripts/data/cache-rasters.ts",
    "crops:build": "tsx scripts/build-crop-catalog.ts",
    "rag:build": "tsx scripts/rag/build.ts",
    "market:areas": "tsx scripts/market/areas.ts",
    "db:start": "npx --yes supabase@3.1.0 start -x gotrue,realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "npx --yes supabase@3.1.0 stop",
    "db:reset": "npx --yes supabase@3.1.0 db reset",
    "db:test": "npx --yes supabase@3.1.0 db lint --level warning --fail-on error && npx --yes supabase@3.1.0 test db",
    "db:load": "tsx scripts/market/load.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/chivo-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-interpolate": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-scale-chromatic": "^3.1.1",
    "d3-shape": "^3.2.1",
    "hono": "^4.13.18",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "maplibre-gl": "^6.18.0",
    "minisearch": "^7.2.0",
    "motion": "^14.14.0",
    "papaparse": "^5.7.1",
    "pngjs": "^7.0.0",
    "proj4": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
