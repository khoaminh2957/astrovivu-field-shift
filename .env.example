# Copy to `.env`. Every variable is optional: the app runs without any key.

# NASA Earthdata Login bearer token (free: https://urs.earthdata.nasa.gov -> Generate Token).
# Unlocks true SMAP L4 / ECOSTRESS / HLS point sampling through NASA AppEEARS in `npm run data:samples`.
EARTHDATA_TOKEN=

# Enables generative answers (crop-knowledge RAG + advisory narratives) through the local API server.
# Without it the assistant answers in grounded extractive mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# USDA NASS QuickStats key (US county yields), optional.
NASS_API_KEY=

# Supabase project that holds the market data (docs/DATABASE.md). Used by `npm run db:load` only.
# Local stack (`npm run db:start`): http://127.0.0.1:54321 and the key printed by
#   npx supabase@3.1.0 gen bearer-jwt --role service_role
# The service role key bypasses row level security: scripts and CI secrets only, never browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Front-end data mode: auto | live | cached | mock
VITE_DATA_MODE=auto
